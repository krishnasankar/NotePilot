<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyAssistant" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>

        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorSecondary</item>

        <item name="colorTertiary">@color/colorAccent</item>
        <item name="colorOnTertiary">@color/colorOnAccent</item>
        <item name="colorTertiaryContainer">@color/colorAccentContainer</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/appBackground</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/textColorPrimary</item>
        <item name="colorSurfaceContainer">@color/surfaceContainer</item>
        <item name="colorSurfaceContainerHighest">@color/surfaceContainerHighest</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/textColorSecondary</item>
        <item name="colorOutline">@color/surfaceOutline</item>

        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/appBackground</item>
        <item name="android:navigationBarColor">@color/surfaceContainer</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>