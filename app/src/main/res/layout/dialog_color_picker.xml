<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surfaceContainer"
    app:cardCornerRadius="20dp"
    app:strokeColor="@color/surfaceOutline"
    app:strokeWidth="1dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_change_color"
            android:textColor="@color/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="6">

            <!-- Default -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorDefault"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surfaceContainerHighest"
                    app:strokeColor="@color/textColorSecondary"
                    app:strokeWidth="1.5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/color_default" />
            </FrameLayout>

            <!-- Coral -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorCoral"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/noteAccentRed"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/color_coral" />
            </FrameLayout>

            <!-- Amber -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorAmber"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/noteAccentAmber"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/color_amber" />
            </FrameLayout>

            <!-- Mint -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorMint"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/noteAccentGreen"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/color_mint" />
            </FrameLayout>

            <!-- Cyan -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorCyan"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/noteAccentCyan"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/color_cyan" />
            </FrameLayout>

            <!-- Lavender -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorLavender"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/noteAccentPurple"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/color_lavender" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
