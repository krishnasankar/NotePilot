<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootNoteDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".NoteDetailActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorBackground"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:navigationIconTint="@color/textColorPrimary"
            app:title=""
            app:menu="@menu/menu_note_detail" />

        <!-- Accent color bar -->
        <View
            android:id="@+id/viewColorAccentBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@android:color/transparent" />

    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Top Title -->
        <EditText
            android:id="@+id/editTextNoteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_note_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/textColorPrimary"
            android:textColorHint="@color/textColorTertiary"
            android:background="@android:color/transparent"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:inputType="textCapSentences"
            android:imeOptions="actionNext" />

        <View
            android:id="@+id/titleSeparator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surfaceOutline"
            android:layout_below="@id/editTextNoteTitle"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="8dp" />

        <!-- Text Content Mode -->
        <EditText
            android:id="@+id/editTextNoteContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/titleSeparator"
            android:layout_above="@id/bottomBar"
            android:background="@android:color/transparent"
            android:gravity="top"
            android:hint="@string/hint_note_content"
            android:inputType="textMultiLine|textCapSentences"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:textColor="@color/textColorPrimary"
            android:textColorHint="@color/textColorTertiary"
            android:lineSpacingExtra="4dp"
            android:textSize="16sp" />

        <!-- Checklist Mode -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChecklist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/titleSeparator"
            android:layout_above="@id/bottomBar"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- Bottom Utility Bar (Pill toggle & metadata counters) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            app:cardBackgroundColor="@color/surfaceContainer"
            app:cardCornerRadius="0dp"
            app:strokeColor="@color/surfaceOutline"
            app:strokeWidth="1dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <!-- Mode toggle button (Checklist / Text) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonToggleMode"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/mode_checklist"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_format_list_bulleted_24"
                    app:iconSize="16dp"
                    app:iconTint="@color/primary"
                    app:cornerRadius="18dp"
                    app:backgroundTint="@color/surfaceContainerHighest" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Checklist progress (hidden for text notes) -->
                <TextView
                    android:id="@+id/textViewMetaStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="12sp"
                    android:paddingHorizontal="8dp"
                    android:visibility="gone"
                    tools:text="0/0 done"
                    tools:visibility="visible" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
