<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/rootLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <!-- App title -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NotePilot"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:letterSpacing="0.08"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/textSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The chat assistant powered by your notes"
        android:textSize="14sp"
        android:textColor="#E0FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toStartOf="@id/textTitle"
        android:layout_marginTop="4dp" />

    <ImageButton
        android:id="@+id/buttonSettings"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        app:srcCompat="@drawable/ic_baseline_settings_24"
    android:contentDescription="Settings"
    android:tint="@android:color/white"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="8dp" />
    <!-- Key status dot (small badge) -->
    <View
        android:id="@+id/keyStatusDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/circle_dot"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="@id/buttonSettings"
        app:layout_constraintEnd_toEndOf="@id/buttonSettings"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"/>


    <LinearLayout
        android:id="@+id/inputCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/editTextPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ask something..."
            android:background="@android:color/transparent"
            android:textColor="@android:color/white"
            android:textColorHint="#B3FFFFFF"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:maxLines="5"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/buttonClearInput"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:tint="@android:color/white"
                android:src="@drawable/ic_delete_24"
                android:contentDescription="Clear input"
                android:padding="4dp"
                android:layout_marginEnd="12dp" />

            <!-- This fills space and pushes buttons to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- ProgressBar (optional, appears before buttons) -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:visibility="gone"
                style="?android:attr/progressBarStyleSmall"
                android:layout_marginEnd="8dp" />

            <!-- NOTES BUTTON integrated near Ask -->
            <ImageButton
                android:id="@+id/buttonNotes"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_menu_edit"
                app:tint="@android:color/white"
                android:contentDescription="Edit notes"
                android:padding="4dp"/>

            <!-- ASK BUTTON -->
            <ImageButton
                android:id="@+id/buttonSend"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_menu_send"
                app:tint="@android:color/white"
                android:contentDescription="Edit notes"
                android:padding="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@+id/textSubtitle"
        app:layout_constraintBottom_toTopOf="@+id/inputCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/fab_safe_bottom"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</androidx.constraintlayout.widget.ConstraintLayout>