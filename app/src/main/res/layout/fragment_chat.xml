<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/inputCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/editTextPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ask something..."
                android:background="@android:color/transparent"
                android:textColor="@android:color/white"
                android:textColorHint="#B3FFFFFF"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:maxLines="5"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="48dp" />

            <ImageButton
                android:id="@+id/buttonClearInput"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_close_24"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@android:color/white"
                android:contentDescription="Clear input"
                android:visibility="gone" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <!-- This fills space and pushes buttons to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- ProgressBar (optional, appears before buttons) -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:visibility="gone"
                style="?android:attr/progressBarStyleSmall"
                android:layout_marginEnd="8dp" />

            <!-- CLEAR CONTEXT BUTTON -->
            <ImageButton
                android:id="@+id/buttonClearContext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_baseline_clear_24"
                app:tint="@android:color/white"
                android:contentDescription="Clear chat context"
                android:padding="4dp"
                android:layout_marginEnd="4dp"/>

            <!-- VOICE INPUT BUTTON -->
            <ImageButton
                android:id="@+id/buttonVoice"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_microphone"
                android:contentDescription="Voice input"
                android:padding="4dp"
                android:layout_marginEnd="4dp"/>

            <!-- ASK BUTTON -->
            <ImageButton
                android:id="@+id/buttonSend"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/send_24px"
                app:tint="@android:color/white"
                android:contentDescription="Edit notes"
                android:padding="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/inputCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/fab_safe_bottom"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</androidx.constraintlayout.widget.ConstraintLayout>
