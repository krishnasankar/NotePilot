<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3300D492">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surfaceElevated" />
            <stroke android:width="1dp" android:color="@color/surfaceOutline" />
            <corners android:radius="20dp" />
            <padding
                android:left="14dp"
                android:top="8dp"
                android:right="14dp"
                android:bottom="8dp" />
        </shape>
    </item>
</ripple>
